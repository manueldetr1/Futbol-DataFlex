37879>>>    Procedure SetActionButtons
37882>>>        tWebNavigateData NavigateData
37882>>>        tWebNavigateData NavigateData
37882>>>        Boolean bHasRecord
37882>>>        Handle hoDD
37882>>>
37882>>>        Get Server to hoDD
37883>>>        Get GetNavigateData to NavigateData
37884>>>        Get HasRecord of hoDD to bHasRecord
37885>>>
37885>>>        // let's hide all buttons and then Show the ones we want
37885>>>        WebSet pbRender of oEditBtn to False
37886>>>        WebSet pbRender of oSaveBtn to False
37887>>>        WebSet pbRender of oCancelChangesBtn to False
37888>>>        WebSet pbRender of oDeleteBtn to False
37889>>>
37889>>>        If (NavigateData.bReadOnly) Begin
37891>>>            WebSet pbRender of oEditBtn to True
37892>>>        End
37892>>>>
37892>>>        Else Begin
37893>>>            WebSet pbRender of oSaveBtn to True
37894>>>            WebSet pbRender of oCancelChangesBtn to True
37895>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37896>>>        End
37896>>>>
37896>>>    End_Procedure
37897>>>
