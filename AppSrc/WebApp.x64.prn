37896>>>    Procedure SetActionButtons
37899>>>        tWebNavigateData NavigateData
37899>>>        tWebNavigateData NavigateData
37899>>>        Boolean bHasRecord
37899>>>        Handle hoDD
37899>>>
37899>>>        Get Server to hoDD
37900>>>        Get GetNavigateData to NavigateData
37901>>>        Get HasRecord of hoDD to bHasRecord
37902>>>
37902>>>        // let's hide all buttons and then Show the ones we want
37902>>>        WebSet pbRender of oEditBtn to False
37903>>>        WebSet pbRender of oSaveBtn to False
37904>>>        WebSet pbRender of oCancelChangesBtn to False
37905>>>        WebSet pbRender of oDeleteBtn to False
37906>>>
37906>>>        If (NavigateData.bReadOnly) Begin
37908>>>            WebSet pbRender of oEditBtn to True
37909>>>        End
37909>>>>
37909>>>        Else Begin
37910>>>            WebSet pbRender of oSaveBtn to True
37911>>>            WebSet pbRender of oCancelChangesBtn to True
37912>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37913>>>        End
37913>>>>
37913>>>    End_Procedure
37914>>>
