37547>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37550>>>>>>>        Case Begin
37550>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37552>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37552>>>>>>>                Case Break
37553>>>>>>>
37553>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37556>>>>>>>                // If from parent, this is a constrained drill down.
37556>>>>>>>                Case Break
37557>>>>>>>
37557>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37560>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37560>>>>>>>                Case Break
37561>>>>>>>
37561>>>>>>>            Case Else // must be nfUndefined
37561>>>>>>>
37561>>>>>>>        Case End
37561>>>>>>>
37561>>>>>>>        Send SetActionButtons
37562>>>>>>>
37562>>>>>>>    End_Procedure
