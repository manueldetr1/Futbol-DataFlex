38231>>>
38231>>>        // let's hide all buttons and then Show the ones we want
38231>>>        WebSet pbRender of oEditBtn to False
38232>>>        WebSet pbRender of oSaveBtn to False
38233>>>        WebSet pbRender of oCancelChangesBtn to False
38234>>>        WebSet pbRender of oDeleteBtn to False
38235>>>
38235>>>        If (NavigateData.bReadOnly) Begin
38237>>>            WebSet pbRender of oEditBtn to True
38238>>>        End
38238>>>>
38238>>>        Else Begin
38239>>>            WebSet pbRender of oSaveBtn to True
38240>>>            WebSet pbRender of oCancelChangesBtn to True
38241>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38242>>>        End
