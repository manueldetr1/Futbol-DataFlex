37920>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37920>>>                Case Break
37921>>>
37921>>>            Case Else // must be nfUndefined
37921>>>
37921>>>        Case End
37921>>>
37921>>>        Send SetActionButtons
37922>>>
