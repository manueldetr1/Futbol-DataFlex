38147>>>>>>>    Procedure SetActionButtons
38150>>>>>>>        tWebNavigateData NavigateData
38150>>>>>>>        tWebNavigateData NavigateData
38150>>>>>>>        Boolean bHasRecord
38150>>>>>>>        Handle hoDD
38150>>>>>>>
38150>>>>>>>        Get Server to hoDD
38151>>>>>>>        Get GetNavigateData to NavigateData
38152>>>>>>>        Get HasRecord of hoDD to bHasRecord
38153>>>>>>>
38153>>>>>>>        // let's hide all buttons and then Show the ones we want
38153>>>>>>>        WebSet pbRender of oEditBtn to False
38154>>>>>>>        WebSet pbRender of oSaveBtn to False
38155>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38156>>>>>>>        WebSet pbRender of oDeleteBtn to False
38157>>>>>>>
38157>>>>>>>        If (NavigateData.bReadOnly) Begin
38159>>>>>>>            WebSet pbRender of oEditBtn to True
38160>>>>>>>        End
38160>>>>>>>>
38160>>>>>>>        Else Begin
38161>>>>>>>            WebSet pbRender of oSaveBtn to True
38162>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38163>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38164>>>>>>>        End
38164>>>>>>>>
38164>>>>>>>    End_Procedure
38165>>>>>>>
