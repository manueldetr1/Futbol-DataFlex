38191>>>    Procedure SetActionButtons
38194>>>        tWebNavigateData NavigateData
38194>>>        tWebNavigateData NavigateData
38194>>>        Boolean bHasRecord
38194>>>        Handle hoDD
38194>>>
38194>>>        Get Server to hoDD
38195>>>        Get GetNavigateData to NavigateData
38196>>>        Get HasRecord of hoDD to bHasRecord
38197>>>
38197>>>        // let's hide all buttons and then Show the ones we want
38197>>>        WebSet pbRender of oEditBtn to False
38198>>>        WebSet pbRender of oSaveBtn to False
38199>>>        WebSet pbRender of oCancelChangesBtn to False
38200>>>        WebSet pbRender of oDeleteBtn to False
38201>>>
38201>>>        If (NavigateData.bReadOnly) Begin
38203>>>            WebSet pbRender of oEditBtn to True
38204>>>        End
38204>>>>
38204>>>        Else Begin
38205>>>            WebSet pbRender of oSaveBtn to True
38206>>>            WebSet pbRender of oCancelChangesBtn to True
38207>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38208>>>        End
38208>>>>
38208>>>    End_Procedure
