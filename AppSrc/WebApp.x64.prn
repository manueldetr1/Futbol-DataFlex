38174>>>>>>>    End_Procedure
38175>>>>>>>
38175>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38178>>>>>>>        Case Begin
38178>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38180>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38180>>>>>>>                Case Break
38181>>>>>>>
38181>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38184>>>>>>>                // If from parent, this is a constrained drill down.
38184>>>>>>>                Case Break
38185>>>>>>>
38185>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38188>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38188>>>>>>>                Case Break
38189>>>>>>>
38189>>>>>>>            Case Else // must be nfUndefined
38189>>>>>>>
38189>>>>>>>        Case End
38189>>>>>>>
38189>>>>>>>        Send SetActionButtons
38190>>>>>>>
38190>>>>>>>    End_Procedure
38191>>>>>>>
38191>>>>>>>End_Object
