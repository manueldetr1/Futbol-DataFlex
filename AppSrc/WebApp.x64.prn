38266>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38266>>>                Case Break
38267>>>
38267>>>            Case Else // must be nfUndefined
38267>>>
38267>>>        Case End
38267>>>
38267>>>        Send SetActionButtons
