38790>>>        Get Server to hoDD
38791>>>        Get GetNavigateData to NavigateData
38792>>>        Get HasRecord of hoDD to bHasRecord
38793>>>
38793>>>        // let's hide all buttons and then Show the ones we want
38793>>>        WebSet pbRender of oEditBtn to False
38794>>>        WebSet pbRender of oSaveBtn to False
38795>>>        WebSet pbRender of oCancelChangesBtn to False
38796>>>        WebSet pbRender of oDeleteBtn to False
38797>>>
38797>>>        If (NavigateData.bReadOnly) Begin
