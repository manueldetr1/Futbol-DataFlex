37571>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37574>>>        Case Begin
37574>>>            Case (NavigateData.eNavigateType = nfFromMain)
37576>>>                // If from main, this is a propbably a main file Select to Zoom.
37576>>>                Case Break
37577>>>
37577>>>            Case (NavigateData.eNavigateType = nfFromParent)
37580>>>                // If from parent, this is a constrained drill down.
