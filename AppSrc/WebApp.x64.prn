37519>>>>>>>    Procedure SetActionButtons
37522>>>>>>>        tWebNavigateData NavigateData
37522>>>>>>>        tWebNavigateData NavigateData
37522>>>>>>>        Boolean bHasRecord
37522>>>>>>>        Handle hoDD
37522>>>>>>>
37522>>>>>>>        Get Server to hoDD
37523>>>>>>>        Get GetNavigateData to NavigateData
37524>>>>>>>        Get HasRecord of hoDD to bHasRecord
37525>>>>>>>
37525>>>>>>>        // let's hide all buttons and then Show the ones we want
37525>>>>>>>        WebSet pbRender of oEditBtn to False
37526>>>>>>>        WebSet pbRender of oSaveBtn to False
37527>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37528>>>>>>>        WebSet pbRender of oDeleteBtn to False
37529>>>>>>>
37529>>>>>>>        If (NavigateData.bReadOnly) Begin
37531>>>>>>>            WebSet pbRender of oEditBtn to True
37532>>>>>>>        End
37532>>>>>>>>
37532>>>>>>>        Else Begin
37533>>>>>>>            WebSet pbRender of oSaveBtn to True
37534>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37535>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37536>>>>>>>        End
37536>>>>>>>>
37536>>>>>>>    End_Procedure
