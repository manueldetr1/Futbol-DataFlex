Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use SelectEntrenador.wo
Use SelectJugador.wo
Use SelectPosicion.wo
Use SelectEquipo.wo
Use SelectLiga.wo

Object oDashboard is a cWebView

    Set piMaxWidth to 1140
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 12
        
        // Banner de cabecera
        Object oHeroBanner is a cWebHtmlBox
            Set piColumnSpan to 12
            Set pbShowBorder to False
            Set psCSSClass to "HeroBanner"
            Set psHtml to '<div class="hero-box"><div><h1>⚽ Gestión Deportiva</h1><p>Panel de administración de clubes, plantillas y competiciones</p></div><div class="hero-badge">Temporada 2026</div></div>'
        End_Object
    
        // Cuadrícula de tarjetas
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 12
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"
    
            Object oTile1 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set psCSSClass to "CustomTile tile-entrenadores"
                Set psHtml to '<div class="tile-card" data-ServerOnClick="openview"><div class="tile-icon">📋</div><div class="tile-content"><h3>Entrenadores</h3><p>Cuerpo técnico y dirección</p></div></div>'
                
                Procedure OnClick String sId String sParam
                    Send Show of oSelectEntrenador
                End_Procedure
            End_Object
    
            Object oTile2 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                Set psCSSClass to "CustomTile tile-jugadores"
                Set psHtml to '<div class="tile-card" data-ServerOnClick="openview"><div class="tile-icon">🏃</div><div class="tile-content"><h3>Jugadores</h3><p>Fichas, dorsales y plantillas</p></div></div>'
                
                Procedure OnClick String sId String sParam
                    Send Show of oSelectJugador
                End_Procedure
            End_Object
    
            Object oTile3 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 8
                Set psCSSClass to "CustomTile tile-posiciones"
                Set psHtml to '<div class="tile-card" data-ServerOnClick="openview"><div class="tile-icon">🎯</div><div class="tile-content"><h3>Posiciones</h3><p>Demarcaciones en el terreno</p></div></div>'
    
                Procedure OnClick String sId String sParam
                    Send Show of oSelectPosicion
                End_Procedure
            End_Object

            Object oTile4 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                Set psCSSClass to "CustomTile tile-equipos"
                Set psHtml to '<div class="tile-card" data-ServerOnClick="openview"><div class="tile-icon">🛡️</div><div class="tile-content"><h3>Equipos</h3><p>Clubes y escuadras registradas</p></div></div>'
                
                Procedure OnClick String sId String sParam
                    Send Show of oSelectEquipo
                End_Procedure
            End_Object

            Object oTile5 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                Set psCSSClass to "CustomTile tile-ligas"
                Set psHtml to '<div class="tile-card" data-ServerOnClick="openview"><div class="tile-icon">🏆</div><div class="tile-content"><h3>Ligas</h3><p>Torneos y competiciones</p></div></div>'
                
                Procedure OnClick String sId String sParam
                    Send Show of oSelectLiga
                End_Procedure
            End_Object
            
        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
    End_Procedure

End_Object